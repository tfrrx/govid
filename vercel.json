{
  "version": 2,
  "name": "govid-lite",
  "builds": [
    {
      "src": "backend/main.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 10
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/dist/$1"
    }
  ],
  "env": {
    "GOVID_MODE": "lite",
    "PYTHONPATH": "backend"
  },
  "functions": {
    "backend/main.py": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}
