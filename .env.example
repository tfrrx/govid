# GoVid 运行配置（复制为 .env 后按需修改）
# 所有变量名都以 GOVID_ 为前缀

# 服务监听地址与端口
GOVID_HOST=0.0.0.0
GOVID_PORT=8000
# 开发时热重载（生产保持 false）
GOVID_RELOAD=false

# 同时进行的真实下载数，超出的任务排队等待
GOVID_MAX_CONCURRENT_DOWNLOADS=2

# 解析时最多返回多少档清晰度
GOVID_MAX_FORMATS=15

# 已完成任务（含临时文件）的保留小时数，超时自动回收
GOVID_TASK_TTL_HOURS=6

# 网络代理，形如 http://127.0.0.1:7890；留空为直连
GOVID_PROXY=

# Netscape 格式 cookies.txt 的绝对路径；留空表示不带 cookies
GOVID_COOKIES_FILE=
